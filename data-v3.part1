{"bases":[{"id":1,"name":"Recursos, petróleo y energía","short":"Recursos","purpose":"Extraer petróleo y materiales de late game.","current":"Petróleo, 3 generadoras, canteras, madera, Cromita y Coralium.","priority":"Priorizar Coralium, Cromita y materiales de late game."},{"id":2,"name":"Hornos y mesas antiguas","short":"Fábrica","purpose":"Fabricación y fundición de último nivel.","current":"4 mesas antiguas y 4 hornos antiguos.","priority":"Priorizar componentes y lingotes que bloqueen el progreso."},{"id":3,"name":"Cocina, agricultura y ganadería alimentaria","short":"Cocina + alimentos","purpose":"Comida, cultivos y ranchos de huevo, leche, miel y algodón caramelizado.","current":"Cocina antigua y producción de ingredientes de pasteles.","priority":"Mantener comida y pasteles para el criadero."},{"id":4,"name":"Ganadería industrial y órganos","short":"Materiales de rancho","purpose":"Órganos, aceite Pal y materiales industriales.","current":"Pendiente de construir.","priority":"Rotar productores según el material faltante."},{"id":5,"name":"Criadero exclusivo","short":"Crianza","purpose":"Solo crianza e incubación.","current":"Pendiente de construir.","priority":"Criar automáticamente los Pals requeridos por las demás bases."},{"id":6,"name":"Reserva estratégica","short":"Reserva","purpose":"Cupo adaptable para el cuello de botella real.","current":"Sin producción fija.","priority":"Activar solo cuando los datos justifiquen duplicar una cadena."}],"tasks":[],"pal_rosters":[],"production":[],"breeding":[],"sources":{"PalDB":"https://paldb.cc/","Palworld Wiki":"https://palworldwiki.info/"}}