{"bases":[{"id":1,"name":"Recursos, petróleo y energía","short":"Recursos","purpose":"Extraer petróleo y materiales de late game sin mezclar fabricación, cocina ni crianza.","current":"3 generadoras existentes; canteras y maderas; 1 sintetizador configurado para Cromita y 1 para Coralium.","priority":"Coralium y Cromita primero; después materiales especiales y minerales industriales. Reducir piedra/madera cuando el stock ya sea suficiente."},{"id":2,"name":"Hornos y mesas antiguas","short":"Fábrica","purpose":"Mantener activas las 4 mesas de trabajo y los 4 hornos, con trabajadores separados por aptitud.","current":"4 mesas de trabajo antiguas y 4 hornos antiguos.","priority":"Lingotes y componentes de late game; luego munición, esferas, equipo y medicina."},{"id":3,"name":"Cocina, agricultura y ganadería alimentaria","short":"Cocina + alimentos","purpose":"Producir cultivos, comida y todos los pasteles, integrando los ranchos que alimentan directamente a la cocina.","current":"1 cocina antigua de último nivel; aquí se concentrarán agricultura y ranchos de huevo, leche, miel y algodón caramelizado.","priority":"Asegurar comida para trabajadores y pasteles; los pasteles terminados se trasladan al criadero."},{"id":4,"name":"Ganadería industrial y órganos","short":"Materiales de rancho","purpose":"Producir órganos, aceite Pal y otros materiales pasivos sin competir con los ingredientes de la cocina.","current":"Pendiente de construir como base industrial separada.","priority":"Rotar productores según el stock más bajo y el material que esté bloqueando el late game."},{"id":5,"name":"Criadero exclusivo","short":"Crianza","purpose":"Solo criar: sin cocina, agricultura, minería ni transporte permanente.","current":"Pendiente de construir.","priority":"Crear primero las líneas de trabajadores para las bases 1 a 4 y luego condensar rancheros y soportes."},{"id":6,"name":"Reserva estratégica","short":"Reserva","purpose":"Mantener un cupo adaptable para duplicar el cuello de botella real.","current":"No construir producción fija todavía.","priority":"Activarla solo cuando falte comida/pasteles, materiales, capacidad de fábrica o espacio para contenido nuevo."}],"tasks":[{"id":"B1-01","base":1,"base_name":"Recursos","area":"Infraestructura","type":"Mantener","priority":"P0","item":"3 generadoras eléctricas existentes","pal_no":"","qty_target":3,"qty_current":0,"status":"NO","notes":"Separar sus áreas de acceso y comprobar que ninguna quede sin Pal.","source":"https://www.pcgamer.com/games/survival-crafting/palworld-best-pals/","category":"Construcción"},{"id":"B1-02","base":1,"base_name":"Recursos","area":"Petróleo","type":"Configurar","priority":"P0","item":"Extractores de petróleo disponibles","pal_no":"","qty_target":1,"qty_current":0,"status":"NO","notes":"Mantener energía y transporte sin interrupciones.","source":"","category":"Configuración"},{"id":"B1-03","base":1,"base_name":"Recursos","area":"Materiales especiales","type":"Configurar","priority":"P0","item":"Sintetizador antiguo: Cromita","pal_no":"","qty_target":1,"qty_current":0,"status":"NO","notes":"Solo admite un Pal; asignar el mejor minero disponible.","source":"https://paldb.cc/en/Ancient_Material_Synthesizer","category":"Configuración"},{"id":"B1-04","base":1,"base_name":"Recursos","area":"Materiales especiales","type":"Configurar","priority":"P0","item":"Sintetizador antiguo: Coralium","pal_no":"","qty_target":1,"qty_current":0,"status":"NO","notes":"Solo admite un Pal; asignar el mejor minero disponible.","source":"https://paldb.cc/en/Ancient_Material_Synthesizer","category":"Configuración"},{"id":"B1-05","base":1,"base_name":"Recursos","area":"Infraestructura","type":"Construir","priority":"P0","item":"Canteras/minas de mayor prioridad","pal_no":"","qty_target":1,"qty_current":0,"status":"NO","notes":"Permitir varios mineros y reasignar según stock de late game.","source":"","category":"Construcción"},{"id":"B1-06","base":1,"base_name":"Recursos","area":"Infraestru