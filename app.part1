const DEFAULT_DATA = JSON.parse((await Promise.all(["data.part1","data.part2","data.part3","data.part4","data.part5"].map(async (name) => { const response = await fetch(name, {cache:"no-store"}); if (!response.ok) throw new Error(`No se pudo cargar ${name}`); return response.text(); }))).join(""));
